{
  "WebhookAuthentication": {
    "ApiKey": "local-dev-key"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "ConsumerEnabled": true
  },
  "RequestCatcher": {
    "Enabled": true,
    "BaseUrl": "https://webhooks.requestcatcher.com",
    "TimeoutSeconds": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
