{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SalesforceSimulator": {
    "BaseUrl": "http://127.0.0.1:5280/",
    "TimeoutSeconds": 10
  },
  "WebhookRateLimit": {
    "PermitLimit": 30,
    "WindowSeconds": 60
  },
  "RabbitMq": {
    "ConsumerEnabled": false,
    "ConsumerPrefetchCount": 1,
    "MaximumRetryCount": 5,
    "InitialRetryDelayMilliseconds": 1000,
    "MaximumRetryDelayMilliseconds": 30000,
    "ReconnectDelaySeconds": 5
  }
}
